# QlikAnswersApp — local environment template
# Copy to .env (gitignored per .gitignore:30) — never commit real values.
# See CONTEXT.md: Tenant Configuration and docs/technical-proposal.md:4 & docs/poc-tickets/01-verify-assistants-api-by-hand.md

# ── Tenant Configuration (non-secret, per Customer) ────────────────────
# Required for every ticket. In production these come from MDM (iOS: com.apple.configuration.managed,
# Android: RestrictionsManager); in internal/dev builds they fall back to src/config/development.ts
# See docs/technical-proposal.md:254 (TenantConfig) and CONTEXT.md:58
QLIK_TENANT_HOST=your-tenant.eu.qlikcloud.com
# No scheme, no trailing slash. Example: acme.eu.qlikcloud.com

QLIK_CLIENT_ID=your-native-oauth-client-id
# Native OAuth client in that tenant (appType=native, PKCE S256). Created by TenantAdmin.
# See docs/research-integration-gaps.md:7 and docs/technical-proposal.md:551

QLIK_ASSISTANT_ID=your-classic-assistant-id
# UUID of a CLASSIC Assistant (Knowledge Base only). Ticket 01 is blocked until this exists —
# current tenant has only an agentic Assistant (/api/v1/cloud-assistants/...) which the published
# /api/v1/assistants/... does not serve. See docs/poc-tickets/01-verify-assistants-api-by-hand.md:9

# ── Ticket 01 hand verification (curl, no app code) ────────────────────
# Easiest path for docs/poc-tickets/01-verify-assistants-api-by-hand.md:5 is a personal API key,
# so verification is decoupled from the PKCE flow. Generate at Qlik Cloud > Management Console > API keys.
# The app itself NEVER uses this — it authenticates per-Qlik User via PKCE (docs/technical-proposal.md:114).
QLIK_API_KEY=your-personal-api-key
# Used as: Authorization: Bearer $QLIK_API_KEY
# Alternative for manual testing without an API key: paste an OAuth access_token here after a PKCE exchange
# QLIK_BEARER_TOKEN=

# Optional: override prompt used for invoke/stream fixtures
# QLIK_TEST_PROMPT=What changed in the Q3 policy?
